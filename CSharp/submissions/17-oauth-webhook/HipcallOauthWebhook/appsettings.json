{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hipcall": {
    "BaseUrl": "https://use.hipcall.com.tr",
    "AuthorizationUrl": "https://use.hipcall.com.tr/oauth/authorize",
    "TokenUrl": "https://use.hipcall.com.tr/oauth/token",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "RedirectUri": "https://your-tunnel.ngrok-free.dev/callback",
    "WebhookReceiverUrl": "https://your-tunnel.ngrok-free.dev/evet=12345",
    "State": "YOUR_CSRF_STATE",
    "Scopes": "profile email offline_access contacts:read webhooks webhooks:read webhooks:write communication communication:read",
    "DefaultWebhookName": "Acme SaaS - Hangup Sync",
    "DefaultEventTypes": [
      "call.ended"
    ],
    "StateStorePath": "webhook_store.json"
  }
}
